<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep warm obsidian background circle with subtle dark edge gradient -->
    <path
        android:pathData="M54,4 A50,50 0 1,0 54,104 A50,50 0 1,0 54,4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="46"
                android:gradientRadius="52"
                android:type="radial">
                <item android:offset="0.0" android:color="#2C2825" />
                <item android:offset="0.6" android:color="#1A1816" />
                <item android:offset="1.0" android:color="#0F0E0D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer fine brass accent circular rim -->
    <path
        android:pathData="M54,6 A48,48 0 1,0 54,102 A48,48 0 1,0 54,6 Z"
        android:strokeWidth="1.2"
        android:strokeColor="#55D4A359" />

    <!-- Subtle inner knurled grip ring -->
    <path
        android:pathData="M54,11 A43,43 0 1,0 54,97 A43,43 0 1,0 54,11 Z"
        android:strokeWidth="0.8"
        android:strokeColor="#26D4A359" />
</vector>
